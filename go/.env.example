#############################################
# Application
#############################################
# Runtime environment: development | test | production
APP_ENV=development

# HTTP server
PORT=8090
HOST=0.0.0.0

# Public base URL of this API, used by the route index
API_BASE_URL=http://localhost:8090
API_PREFIX=/api/v1

# Comma separated allowlist of CORS origins (CORS_ORIGIN still works too).
# `*` is accepted but never combined with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Maximum accepted request body size (default 100kb)
BODY_LIMIT=100kb

# Trust X-Forwarded-For for the client IP that rate limiters key on.
# Only enable when behind a proxy you control, otherwise limits are spoofable.
TRUST_PROXY=false

# Send Strict-Transport-Security, only on HTTPS requests
ENABLE_HSTS=false

#############################################
# Database
#############################################
# mysql  = MySQL / MariaDB (shared backend_starter database)
# sqlite = file based SQLite (local development without a DB server, tests)
DB_DIALECT=mysql

# --- MySQL settings (ignored when DB_DIALECT=sqlite) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- SQLite settings (ignored when DB_DIALECT=mysql) ---
DB_STORAGE=./database/dev.sqlite

# Create missing tables on boot. Leave false against the shared MySQL database
# and apply database/schema.sql yourself when the tables are not there yet.
DB_SYNC=false

# Log every SQL statement
DB_LOGGING=false

#############################################
# Authentication / JWT
#############################################
# CHANGE THIS in production. Minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter-go
JWT_AUDIENCE=backend-starter-clients

# bcrypt cost factor (10 = default, 4 is only for tests)
BCRYPT_ROUNDS=10

#############################################
# Pagination defaults
#############################################
PAGINATION_LIMIT=10
PAGINATION_MAX_LIMIT=100

#############################################
# Rate limiting (global, per IP). Set RATE_LIMIT_ENABLED=false
# or RATE_LIMIT_MAX=0 to disable. Skipped automatically when APP_ENV=test.
#############################################
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

#############################################
# Login attempt limiter (POST /auth/login only).
# 429 after 3 failed logins per email / 10 per IP within 15 minutes.
# Sliding window, counted on failed credential checks only.
#############################################
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
