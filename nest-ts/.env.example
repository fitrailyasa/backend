# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3003
# Comma separated list of allowed origins, or * for any
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=backend_starter
# Log every SQL query (dev only)
DB_LOGGING=false
# Auto-sync the TypeORM entities into the database (dev only, keep false in production
# and apply database/schema.sql by hand)
DB_SYNCHRONIZE=true
# Run the demo seeder once on boot when the users table is still empty
DB_SEED=true

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-super-secret-access-token
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me-super-secret-refresh-token
JWT_REFRESH_EXPIRES_IN=604800
