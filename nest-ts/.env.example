# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3003
# CORS allowlist, comma separated (legacy alias: CORS_ORIGIN). `*` is allowed
# but is never combined with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Failed logins allowed per email / per 15 minutes (sliding window)
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Failed logins allowed per client IP / per 15 minutes (sliding window)
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
# Global request limit: max requests per IP inside the window (skipped for
# /health, automatically disabled when NODE_ENV=test)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Request body cap (413 above the limit)
BODY_LIMIT=100kb
# Trust X-Forwarded-For (set to true only behind a reverse proxy)
TRUST_PROXY=false
# Send Strict-Transport-Security - only ever applied to HTTPS requests
ENABLE_HSTS=false

# ---------------------------------------------------------------------------
# Database (MySQL / MariaDB)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=backend_starter
# Log every SQL query (dev only)
DB_LOGGING=false
# Auto-sync the TypeORM entities into the database (dev only, keep false in production
# and apply database/schema.sql by hand)
DB_SYNCHRONIZE=true
# Run the demo seeder once on boot when the users table is still empty
DB_SEED=true

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-super-secret-access-token
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me-super-secret-refresh-token
JWT_REFRESH_EXPIRES_IN=604800
