#############################################
# Application
#############################################
# Runtime environment: development | test | production
NODE_ENV=development

# HTTP server
PORT=3000
HOST=0.0.0.0

# Public base URL of this API, used to build the docs metadata
API_BASE_URL=http://localhost:3000
API_PREFIX=/api/v1

# Comma separated allow-list of CORS origins. `*` is never combined with
# credentials: a `*` (or empty) value falls back to the dev allow-list below.
# The legacy key CORS_ORIGIN is still accepted when CORS_ORIGINS is unset.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Maximum accepted request body size (413 envelope when exceeded)
BODY_LIMIT=100kb

# Trust X-Forwarded-* headers from a reverse proxy. Accepts false | true |
# a hop count (e.g. 1) | any Express proxy definition (e.g. loopback).
# Leave false when not behind a proxy, otherwise client IPs (and IP based
# rate limits) become spoofable.
TRUST_PROXY=false

# Send Strict-Transport-Security on HTTPS requests. Off by default because the
# API is served over plain HTTP in development.
ENABLE_HSTS=false

# Log format: combined | dev | tiny | short
LOG_FORMAT=dev

#############################################
# Database
#############################################
# mysql  = MySQL / MariaDB (production)
# sqlite = file based or in-memory SQLite (local development without a DB server, tests)
DB_DIALECT=mysql

# --- MySQL settings (ignored when DB_DIALECT=sqlite) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# MySQL connection pool
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE=10000
DB_POOL_ACQUIRE=30000

# --- SQLite settings (ignored when DB_DIALECT=mysql) ---
# Use ":memory:" for an ephemeral in-process database
DB_STORAGE=./database/dev.sqlite

# Run `sequelize.sync()` on boot. Keep true for development, set false in
# production and apply database/schema.sql manually.
DB_SYNC=true

# Drop and recreate every table when `sequelize.sync()` runs. Never use in production.
DB_SYNC_FORCE=false

# Log every SQL statement to stdout
DB_LOGGING=false

#############################################
# Authentication / JWT
#############################################
# CHANGE THIS in production. Minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter-express
JWT_AUDIENCE=backend-starter-clients

# bcrypt cost factor (10 = default, raise to 12 in production)
BCRYPT_ROUNDS=10

#############################################
# Pagination defaults
#############################################
# Default page size for every collection endpoint
PAGINATION_LIMIT=10
# Hard upper bound for the ?limit query parameter
PAGINATION_MAX_LIMIT=100

#############################################
# Rate limiting
#############################################
# Global limit per client IP on every route except /health and the API index.
# Automatically disabled when NODE_ENV=test. Set RATE_LIMIT_MAX to 0 to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Per IP limit on /auth/register, /auth/login and /auth/refresh.
# Set AUTH_RATE_LIMIT_MAX to 0 to disable.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# Failed login limiter on /auth/login (sliding window, counts failed
# credential checks only). A locked account answers 429 + Retry-After.
# 3 failures per normalized email, 10 failures per client IP, per 15 minutes.
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000

#############################################
# Logging
#############################################
# Request id header used to correlate logs (inbound value is honoured when present)
REQUEST_ID_HEADER=X-Request-Id
LOG_LEVEL=info
