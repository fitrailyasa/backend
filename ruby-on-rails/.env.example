# Server. Express already uses 3000; this API listens on 3001.
PORT=3001
RAILS_ENV=development
SECRET_KEY_BASE=change-me-to-a-long-random-string

# MySQL / MariaDB. Database name is shared across the starter kits.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=

# JWT. Access 3600s, refresh 604800s. Separate secrets fall back to JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string-32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_ROUNDS=10
CORS_ORIGIN=*

# Simple Rack throttle for POST /api/v1/auth/register, /login, /refresh.
# Set RATE_LIMIT_MAX=0 to disable.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
