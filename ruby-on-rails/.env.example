# Server. Express already uses 3000; this API listens on 3001.
PORT=3001
RAILS_ENV=development
SECRET_KEY_BASE=change-me-to-a-long-random-string

# MySQL / MariaDB. Database name is shared across the starter kits.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=

# JWT. Access 3600s, refresh 604800s. Separate secrets fall back to JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string-32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

BCRYPT_ROUNDS=10

# CORS: comma separated origin allowlist. "*" is allowed but is never combined
# with credentials (this API uses Bearer tokens, not cookies).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Global request throttle: 300 requests / 60s per IP, /health excluded.
# Disabled automatically in the test env; RATE_LIMIT_ENABLED=false turns it off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Throttle for POST /api/v1/auth/register, /login, /refresh per IP.
# Set AUTH_RATE_LIMIT_MAX=0 to disable.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# Login lockout: 3 failed logins per normalized email and 10 per client IP
# per 15 minutes, counted only on failed credential checks.
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000

# Request bodies larger than BODY_LIMIT are rejected with 413.
BODY_LIMIT=100kb

# Trust X-Forwarded-For / X-Forwarded-Proto. Only enable behind a proxy.
TRUST_PROXY=false

# Send Strict-Transport-Security on HTTPS responses.
ENABLE_HSTS=false
