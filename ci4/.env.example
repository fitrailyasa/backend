CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# Same names the other frameworks read. database.default.* still overrides these.
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = backend_starter
DB_USER = root
DB_PASSWORD =

database.default.hostname = 127.0.0.1
database.default.database = backend_starter
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

JWT_SECRET = 'replace-with-a-random-secret-at-least-32-characters'
JWT_EXPIRES_IN = 3600
JWT_REFRESH_EXPIRES_IN = 604800
encryption.key =

# --- Security (see README "Security") -------------------------------------
# Global request limit per IP (automatically off while CI_ENVIRONMENT=testing).
RATE_LIMIT_ENABLED = true
RATE_LIMIT_MAX = 300
RATE_LIMIT_WINDOW_MS = 60000

# Failed-login lockout: per normalized email, then per client IP.
LOGIN_RATE_LIMIT_MAX = 3
LOGIN_RATE_LIMIT_WINDOW_MS = 900000
LOGIN_IP_RATE_LIMIT_MAX = 10
LOGIN_IP_RATE_LIMIT_WINDOW_MS = 900000

# Request body cap in bytes (100kb).
BODY_LIMIT = 102400

# CORS allowlist (comma separated). Never '*' together with credentials.
CORS_ORIGINS = 'http://localhost:3000,http://localhost:5173,http://localhost:4200'

# Trust X-Forwarded-For only when behind a reverse proxy (default: false).
TRUST_PROXY = false

# Strict-Transport-Security, sent on HTTPS requests only (default: false).
ENABLE_HSTS = false