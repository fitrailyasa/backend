# ==========================================
#  Application
# ==========================================
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
CORS_ORIGIN=*

# ==========================================
#  Database
#  DB_DIALECT: mysql (production) | sqlite (local smoke test)
# ==========================================
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_NAME=backend_starter
DB_CHARSET=utf8mb4
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10
# only used when DB_DIALECT=sqlite (test / demo)
DB_STORAGE=./database.sqlite

# ==========================================
#  Seeder - run demo data on boot
# ==========================================
DB_SEED=false
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

# ==========================================
#  JWT
# ==========================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=604800

# ==========================================
#  Validation / pagination
# ==========================================
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
BCRYPT_SALT_ROUNDS=10
