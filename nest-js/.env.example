# ==========================================
#  Application
# ==========================================
NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
# CORS allowlist, comma separated (legacy alias: CORS_ORIGIN). `*` is allowed
# but is never combined with credentials.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ==========================================
#  Security
# ==========================================
# Failed logins allowed per email / per 15 minutes (sliding window)
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Failed logins allowed per client IP / per 15 minutes (sliding window)
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
# Global request limit: max requests per IP inside the window (skipped for /health,
# automatically disabled when NODE_ENV=test)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
# Request body cap (413 above the limit)
BODY_LIMIT=100kb
# Trust X-Forwarded-For (set to true only behind a reverse proxy)
TRUST_PROXY=false
# Send Strict-Transport-Security - only ever applied to HTTPS requests
ENABLE_HSTS=false

# ==========================================
#  Database
#  DB_DIALECT: mysql (production) | sqlite (local smoke test)
# ==========================================
DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_NAME=backend_starter
DB_CHARSET=utf8mb4
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10
# only used when DB_DIALECT=sqlite (test / demo)
DB_STORAGE=./database.sqlite

# ==========================================
#  Seeder - run demo data on boot
# ==========================================
DB_SEED=false
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password

# ==========================================
#  JWT
# ==========================================
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=604800

# ==========================================
#  Validation / pagination
# ==========================================
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100
BCRYPT_SALT_ROUNDS=10
