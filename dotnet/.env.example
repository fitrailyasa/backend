# MySQL / MariaDB — database backend_starter
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=

# JWT. Secret must be at least 32 characters. Access and refresh secrets are optional.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Set to true to insert demo data on startup when admin@example.com does not exist.
SEED_ENABLED=false

# Login attempt limiter: failed logins allowed per email / per client IP and window (ms).
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000

# Global request rate limit: 300 requests / 60000 ms per IP (health and route index excluded).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Comma separated CORS allowlist (never '*' together with credentials).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy (loopback proxies only).
TRUST_PROXY=false

# Send Strict-Transport-Security on HTTPS responses (off by default).
ENABLE_HSTS=false

# Maximum request body size in bytes (100kb).
BODY_LIMIT=102400
