# MySQL / MariaDB — database backend_starter
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=

# JWT. Secret must be at least 32 characters. Access and refresh secrets are optional.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# Set to true to insert demo data on startup when admin@example.com does not exist.
SEED_ENABLED=false
