{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "DataSource=:memory:"
  },
  "Seed": {
    "Enabled": false
  },
  "Jwt": {
    "Secret": "testing-secret-key-at-least-32-characters",
    "ExpiresIn": 3600,
    "RefreshExpiresIn": 604800,
    "Issuer": "backend-starter-dotnet",
    "Audience": "backend-starter-clients"
  },
  "RateLimit": {
    "Enabled": false,
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "LoginRateLimit": {
    "MaxAttempts": 3,
    "WindowSeconds": 900,
    "IpMaxAttempts": 10,
    "IpWindowSeconds": 900
  }
}
