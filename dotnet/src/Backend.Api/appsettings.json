{
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=backend_starter;User=root;Password=;"
  },
  "Jwt": {
    "Secret": "change-me-to-a-long-random-string-at-least-32-chars",
    "ExpiresIn": 3600,
    "RefreshExpiresIn": 604800,
    "Issuer": "backend-starter-dotnet",
    "Audience": "backend-starter-clients"
  },
  "Seed": {
    "Enabled": false
  },
  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 300,
    "WindowSeconds": 60
  },
  "LoginRateLimit": {
    "MaxAttempts": 3,
    "WindowSeconds": 900,
    "IpMaxAttempts": 10,
    "IpWindowSeconds": 900
  },
  "Cors": {
    "Origins": "http://localhost:3000,http://localhost:5173,http://localhost:4200"
  },
  "TrustProxy": false,
  "Hsts": {
    "Enabled": false
  },
  "BodyLimit": {
    "MaxBytes": 102400
  },
  "Api": {
    "BaseUrl": "http://localhost:5080"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
