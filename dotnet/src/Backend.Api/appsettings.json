{
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=backend_starter;User=root;Password=;"
  },
  "Jwt": {
    "Secret": "change-me-to-a-long-random-string-at-least-32-chars",
    "ExpiresIn": 3600,
    "RefreshExpiresIn": 604800,
    "Issuer": "backend-starter-dotnet",
    "Audience": "backend-starter-clients"
  },
  "Seed": {
    "Enabled": false
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 900
  },
  "Api": {
    "BaseUrl": "http://localhost:5080"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
