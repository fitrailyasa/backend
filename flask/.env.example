#############################################
# Application
#############################################
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

# Comma separated allowlist. Never combine * with credentials: a bare * is
# ignored and the dev allowlist below is used instead.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Request body limit (bytes, or a value like 1mb / 512kb). Default 100kb.
BODY_LIMIT=100kb

# Trust X-Forwarded-For / X-Forwarded-Proto when behind a reverse proxy
TRUST_PROXY=false

# Send Strict-Transport-Security (only ever on HTTPS responses)
ENABLE_HSTS=false

#############################################
# Database (MySQL / MariaDB)
#############################################
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

DB_POOL_MAX=10

#############################################
# Authentication / JWT
#############################################
# CHANGE THIS in production. Minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter-flask
JWT_AUDIENCE=backend-starter-clients

# bcrypt cost factor (10 = default, 4 is fine for local tests)
BCRYPT_ROUNDS=10

#############################################
# Pagination
#############################################
PAGINATION_LIMIT=10
PAGINATION_MAX_LIMIT=100

#############################################
# Rate limiting
#############################################
# Global request limit: everything except /health and the API index.
# Automatically disabled when the env flag says "test".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Extra limit on the auth routes (register / login / refresh), per endpoint + IP.
# Set AUTH_RATE_LIMIT_MAX=0 to disable it.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=100

# Failed login limiter (POST /api/v1/auth/login): sliding window, counted only
# on failed credential checks, reset for an email on a successful login.
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
