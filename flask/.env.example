#############################################
# Application
#############################################
FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

# Comma separated origins, or * for any
CORS_ORIGIN=*

# Request body limit (bytes, or a value like 1mb / 512kb)
BODY_LIMIT=1mb

#############################################
# Database (MySQL / MariaDB)
#############################################
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

DB_POOL_MAX=10

#############################################
# Authentication / JWT
#############################################
# CHANGE THIS in production. Minimum 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter-flask
JWT_AUDIENCE=backend-starter-clients

# bcrypt cost factor (10 = default, 4 is fine for local tests)
BCRYPT_ROUNDS=10

#############################################
# Pagination
#############################################
PAGINATION_LIMIT=10
PAGINATION_MAX_LIMIT=100

#############################################
# Rate limiting (register, login, refresh)
#############################################
# Set RATE_LIMIT_MAX=0 to disable
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
