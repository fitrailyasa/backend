# Copy to .env (optional). The process environment is the source of truth.
# application.yml maps the same names through ${ENV:default}.
# A .env file in the working directory is loaded only for keys that are not already set.

PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change-me-to-a-secret-at-least-32-chars
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter
JWT_AUDIENCE=backend-starter-clients

# true, or activate the Spring profile "seed"
APP_SEED=false
BCRYPT_ROUNDS=10

# CORS: comma separated explicit origins. A bare * falls back to the default allowlist.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Global rate limit (requests per window per IP; skipped automatically in the test profile)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Existing stricter limit on the auth routes (register / login / refresh), per IP per endpoint
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000

# Login attempt limiter: failed logins per normalized email / per client IP
LOGIN_RATE_LIMIT_MAX=3
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000

# Hardening
TRUST_PROXY=false
ENABLE_HSTS=false
# Max JSON request body in bytes (100kb)
BODY_LIMIT=102400
