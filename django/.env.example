#############################################
# Application
#############################################
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DJANGO_DEBUG=true

# HTTP server (README: python manage.py runserver 0.0.0.0:8000)
PORT=8000

# Comma separated origins, or * for any
CORS_ORIGIN=*

#############################################
# Database
#############################################
# mysql = MySQL / MariaDB (default runtime)
# sqlite = file SQLite when MySQL is not installed
DB_DIALECT=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# Used only when DB_DIALECT=sqlite
DB_STORAGE=database/dev.sqlite

#############################################
# Authentication / JWT
#############################################
# Minimum 32 characters. Change this in any shared environment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave empty to reuse JWT_SECRET
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter-django
JWT_AUDIENCE=backend-starter-clients

# bcrypt cost factor
BCRYPT_ROUNDS=10

#############################################
# Pagination
#############################################
PAGINATION_LIMIT=10
PAGINATION_MAX_LIMIT=100

#############################################
# Rate limiting (register, login, refresh). Set RATE_LIMIT_MAX=0 to disable.
#############################################
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
