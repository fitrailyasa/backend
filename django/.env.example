#############################################
# Application
#############################################
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DJANGO_DEBUG=true

# HTTP server (README: python manage.py runserver 0.0.0.0:8000)
PORT=8000

# Comma separated CORS allowlist (never '*' combined with credentials;
# '*' or empty falls back to the dev allowlist below)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

#############################################
# Database
#############################################
# mysql = MySQL / MariaDB (default runtime)
# sqlite = file SQLite when MySQL is not installed
DB_DIALECT=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backend_starter
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# Used only when DB_DIALECT=sqlite
DB_STORAGE=database/dev.sqlite

#############################################
# Authentication / JWT
#############################################
# Minimum 32 characters. Change this in any shared environment.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Leave empty to reuse JWT_SECRET
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Access token lifetime in seconds (default 3600 = 1 hour)
JWT_EXPIRES_IN=3600
# Refresh token lifetime in seconds (default 604800 = 7 days)
JWT_REFRESH_EXPIRES_IN=604800
JWT_ISSUER=backend-starter-django
JWT_AUDIENCE=backend-starter-clients

# bcrypt cost factor
BCRYPT_ROUNDS=10

#############################################
# Pagination
#############################################
PAGINATION_LIMIT=10
PAGINATION_MAX_LIMIT=100

#############################################
# Rate limiting (all limits are sliding windows, per process)
#############################################
# Global: requests per client IP over a 60s window. /health and /api/v1 are
# exempt; automatically disabled under pytest. Set RATE_LIMIT_MAX=0 to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Login lockout: failed logins per normalized email (401s only), then per IP
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=3
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=10

#############################################
# Security
#############################################
# Max request body in bytes (default 102400 = 100kb). 0 disables the cap.
BODY_LIMIT=102400
# Trust X-Forwarded-For / X-Forwarded-Proto. Only enable behind a reverse proxy.
TRUST_PROXY=false
# Send Strict-Transport-Security on HTTPS responses (off by default)
ENABLE_HSTS=false
